---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-neutral-200/80 dark:border-neutral-800 bg-[#fdfcfb] dark:bg-[#18181b] text-neutral-600 dark:text-neutral-400 mt-16 no-print">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Brand & About -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-3 group" title="TheOnlineProtractor.com">
          <div class="w-9 h-7 rounded-lg bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 flex items-center justify-center p-0.5 shadow-2xs overflow-hidden group-hover:scale-105 transition-transform">
            <img src="/logo.svg" alt="TheOnlineProtractor.com Logo" class="w-full h-full object-contain" width="36" height="28" />
          </div>
          <span class="font-black text-neutral-900 dark:text-white text-base">TheOnlineProtractor<span class="text-blue-600 dark:text-sky-400">.com</span></span>
        </a>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed mb-4">
          The #1 free online protractor tool and geometry measurement workspace. Measure angles from photos, homework worksheets, and diagrams with 0.1° accuracy.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 text-[11px] font-bold border border-emerald-200/60 dark:border-emerald-800">
          <span>🔒 100% Client-Side & Private</span>
        </div>
      </div>

      <!-- Col 2: Online Protractor Tools -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          Protractor Tools & Modes
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">180° Online Protractor</a>
          </li>
          <li>
            <a href="/360-degree-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">360° Digital Protractor Tool</a>
          </li>
          <li>
            <a href="/image-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">Measure Angles with a Protractor Worksheet</a>
          </li>
          <li>
            <a href="/printable-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">Protractor Printable (1:1 PDF / A4)</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Geometry & Angle Guides -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          Geometry & Angle Guides
        </h4>
        <ul class="space-y-1.5 text-xs text-neutral-600 dark:text-neutral-400">
          <li><a href="/#what-is-a-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">What is a Protractor?</a></li>
          <li><a href="/#how-to-use-a-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">How to Use a Protractor to Measure Angles</a></li>
          <li><a href="/#how-to-read-a-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">How to Read a Protractor (Double Scales)</a></li>
          <li><a href="/#protractor-and-compass" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">Protractor and Compass Constructions</a></li>
          <li><a href="/#without-protractor" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">How to Measure Angles Without a Protractor</a></li>
        </ul>
      </div>

      <!-- Col 4: About, Contact & Legal -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 dark:text-white mb-3">
          Company & Legal
        </h4>
        <ul class="space-y-2 text-xs text-neutral-600 dark:text-neutral-400">
          <li><a href="/about" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">📖 About Us</a></li>
          <li><a href="/contact" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">📬 Contact & Feedback (Google Sheets)</a></li>
          <li><a href="/privacy-policy" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">🔒 Privacy Policy</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-blue-600 dark:hover:text-sky-400 transition-colors">📜 Terms & Conditions</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-neutral-200/60 dark:border-neutral-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400 dark:text-neutral-500">
      <p>© {currentYear} <strong>TheOnlineProtractor.com</strong>. All rights reserved. Free for students, teachers, and classrooms.</p>
      <div class="flex items-center gap-4 text-xs">
        <a href="/about" class="hover:underline">About</a>
        <a href="/contact" class="hover:underline">Contact</a>
        <a href="/privacy-policy" class="hover:underline">Privacy</a>
        <a href="/terms-and-conditions" class="hover:underline">Terms</a>
      </div>
    </div>
  </div>
</footer>
