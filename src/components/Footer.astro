---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-neutral-200/80 bg-[#fdfcfb] text-neutral-600 mt-16 no-print">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: About -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xl">📐</span>
          <span class="font-black text-neutral-900 text-base">TheOnlineProtractor<span class="text-blue-600">.com</span></span>
        </div>
        <p class="text-xs text-neutral-500 leading-relaxed mb-4">
          The ultimate free digital protractor tool and online protractor practice companion. Measure angles from photos, homework worksheets, and diagrams with 0.1° accuracy.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-bold border border-emerald-200/60">
          <span>🔒 100% Client-Side & Private</span>
        </div>
      </div>

      <!-- Col 2: Online Protractor Tools -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 mb-3">
          Protractor Tools & Modes
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" class="hover:text-blue-600 transition-colors">180° Online Protractor</a>
          </li>
          <li>
            <a href="/360-degree-protractor" class="hover:text-blue-600 transition-colors">360° Digital Protractor Tool</a>
          </li>
          <li>
            <a href="/image-protractor" class="hover:text-blue-600 transition-colors">Measure Angles with a Protractor Worksheet</a>
          </li>
          <li>
            <a href="/printable-protractor" class="hover:text-blue-600 transition-colors">Protractor Printable (1:1 PDF / A4)</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Geometry & Angle Guides -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 mb-3">
          Geometry & Angle Guides
        </h4>
        <ul class="space-y-1.5 text-xs text-neutral-600">
          <li><a href="#what-is-a-protractor" class="hover:text-blue-600 transition-colors">What is a Protractor?</a></li>
          <li><a href="#how-to-use-a-protractor" class="hover:text-blue-600 transition-colors">How to Use a Protractor to Measure Angles</a></li>
          <li><a href="#how-to-read-a-protractor" class="hover:text-blue-600 transition-colors">How to Read a Protractor (Double Scales)</a></li>
          <li><a href="#protractor-and-compass" class="hover:text-blue-600 transition-colors">Protractor and Compass Constructions</a></li>
          <li><a href="#without-protractor" class="hover:text-blue-600 transition-colors">How to Measure Angles Without a Protractor</a></li>
        </ul>
      </div>

      <!-- Col 4: Keyboard Shortcuts & Features -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-900 mb-3">
          Digital Protractor Features
        </h4>
        <ul class="space-y-1.5 text-xs text-neutral-500">
          <li><kbd class="px-1.5 py-0.5 bg-neutral-200/60 rounded text-[10px] font-mono font-bold text-neutral-700">Ctrl + V</kbd> Paste image screenshot</li>
          <li><kbd class="px-1.5 py-0.5 bg-neutral-200/60 rounded text-[10px] font-mono font-bold text-orange-700">Orange V</kbd> Move vertex center</li>
          <li><kbd class="px-1.5 py-0.5 bg-neutral-200/60 rounded text-[10px] font-mono font-bold text-blue-700">Blue A</kbd> Align baseline 0° ray</li>
          <li><kbd class="px-1.5 py-0.5 bg-neutral-200/60 rounded text-[10px] font-mono font-bold text-emerald-700">Green B</kbd> Measure second angle ray</li>
          <li><span class="text-neutral-600 font-medium">Loupe:</span> Automatic 2.5x zoom crosshairs</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-neutral-200/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
      <p>© {currentYear} <strong>TheOnlineProtractor.com</strong>. All rights reserved. Free for students, teachers, and classrooms.</p>
      <p>Precision HTML5 Canvas & Vector Mathematics</p>
    </div>
  </div>
</footer>
