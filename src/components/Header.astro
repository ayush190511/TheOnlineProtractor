---
interface Props {
  activePage?: 'home' | 'image' | '360' | 'printable' | 'about' | 'privacy' | 'terms' | 'contact';
}

const { activePage = 'home' } = Astro.props;
---

<header class="w-full border-b border-neutral-200/80 dark:border-neutral-800 bg-white/90 dark:bg-[#18181b]/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" title="TheOnlineProtractor.com — Free Online Protractor">
      <div class="w-10 h-8 rounded-lg bg-white dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 flex items-center justify-center p-0.5 shadow-xs group-hover:scale-105 transition-transform overflow-hidden">
        <img src="/logo.svg" alt="TheOnlineProtractor.com Logo" class="w-full h-full object-contain" width="40" height="32" />
      </div>
      <div class="flex flex-col">
        <span class="font-black text-neutral-900 dark:text-white text-base leading-tight tracking-tight">
          TheOnlineProtractor<span class="text-blue-600 dark:text-sky-400">.com</span>
        </span>
        <span class="text-[10px] text-neutral-500 dark:text-neutral-400 font-medium leading-none tracking-wide hidden sm:inline">
          Free Online Protractor Tool
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium" aria-label="Main Navigation">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'home'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        Standard (180°)
      </a>
      <a
        href="/image-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'image'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        🖼️ Image & Worksheet
      </a>
      <a
        href="/360-degree-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === '360'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        ⭕ 360° Digital Dial
      </a>
      <a
        href="/printable-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'printable'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        🖨️ Printable
      </a>
      <a
        href="/about"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'about'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        About
      </a>
      <a
        href="/contact"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'contact'
            ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
            : 'text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 hover:text-neutral-900 dark:hover:text-white'
        }`}
      >
        Contact
      </a>
    </nav>

    <!-- Right Controls: Dark Mode Switch + PDF Button + Hamburger -->
    <div class="flex items-center gap-2">
      <!-- Dark / Light Mode Switcher Button -->
      <button
        type="button"
        id="theme-toggle-btn"
        aria-label="Toggle Dark / Light Mode"
        class="w-9 h-9 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-200 flex items-center justify-center transition-colors cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="theme-sun-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="theme-moon-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Printable Button -->
      <a
        href="/printable-protractor"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-sky-300 text-xs font-bold hover:bg-blue-100 dark:hover:bg-blue-900/60 transition-colors border border-blue-200/60 dark:border-blue-800 shadow-2xs"
      >
        <span>Print PDF</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Open Navigation Menu"
        class="lg:hidden w-9 h-9 rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-700 flex items-center justify-center text-neutral-700 dark:text-neutral-200 cursor-pointer transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-neutral-200 dark:border-neutral-800 bg-white dark:bg-[#18181b] px-4 py-3 space-y-1 shadow-lg">
    <a
      href="/"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        activePage === 'home'
          ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
          : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800'
      }`}
    >
      📐 Standard (180°) Protractor
    </a>
    <a
      href="/image-protractor"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        activePage === 'image'
          ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
          : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800'
      }`}
    >
      🖼️ Image & Worksheet Angle Finder
    </a>
    <a
      href="/360-degree-protractor"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        activePage === '360'
          ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
          : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800'
      }`}
    >
      ⭕ 360° Digital Dial Protractor
    </a>
    <a
      href="/printable-protractor"
      class={`block px-3 py-2 rounded-lg text-sm font-medium ${
        activePage === 'printable'
          ? 'bg-neutral-100 dark:bg-neutral-800 text-blue-600 dark:text-sky-400 font-semibold'
          : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800'
      }`}
    >
      🖨️ Printable Protractor (1:1 Scale PDF)
    </a>
    <div class="border-t border-neutral-100 dark:border-neutral-800 my-2 pt-2 grid grid-cols-2 gap-1 text-xs text-neutral-600 dark:text-neutral-400">
      <a href="/about" class="px-3 py-1.5 hover:text-blue-600 dark:hover:text-sky-400">About Us</a>
      <a href="/contact" class="px-3 py-1.5 hover:text-blue-600 dark:hover:text-sky-400">Contact Us</a>
      <a href="/privacy-policy" class="px-3 py-1.5 hover:text-blue-600 dark:hover:text-sky-400">Privacy Policy</a>
      <a href="/terms-and-conditions" class="px-3 py-1.5 hover:text-blue-600 dark:hover:text-sky-400">Terms & Conditions</a>
    </div>
  </div>
</header>

<script>
  // Mobile Hamburger Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Dark Mode Toggle Logic
  const themeBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }
  }

  updateIcons();

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });
  }
</script>
