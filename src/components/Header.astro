---
interface Props {
  activePage?: 'home' | 'image' | '360' | 'printable';
}

const { activePage = 'home' } = Astro.props;
---

<header class="w-full border-b border-neutral-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo with Custom SVG -->
    <a href="/" class="flex items-center gap-2.5 group" title="TheOnlineProtractor.com — Free Online Protractor">
      <div class="w-10 h-10 rounded-xl bg-slate-50 border border-neutral-200/80 flex items-center justify-center p-1 shadow-2xs group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%" fill="none" class="w-full h-full">
          <!-- Semi-circle protractor base -->
          <path d="M 30 140 A 70 70 0 0 1 170 140 Z" stroke="#334155" stroke-width="4" stroke-linejoin="round" fill="none" />
          
          <!-- Base reference line -->
          <line x1="30" y1="140" x2="170" y2="140" stroke="#334155" stroke-width="4" stroke-linecap="round" />
          
          <!-- Angle Ray (60 degrees) -->
          <line x1="100" y1="140" x2="145" y2="62" stroke="#2563EB" stroke-width="4" stroke-linecap="round" />
          
          <!-- Base Ray (0 degrees) -->
          <line x1="100" y1="140" x2="160" y2="140" stroke="#2563EB" stroke-width="4" stroke-linecap="round" />
          
          <!-- Curved angle arc -->
          <path d="M 130 140 A 30 30 0 0 0 115 114" stroke="#2563EB" stroke-width="3" stroke-linecap="round" fill="none" />
          
          <!-- Orange vertex dot -->
          <circle cx="100" cy="140" r="6" fill="#F97316" stroke="#FFFFFF" stroke-width="2" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-black text-neutral-900 text-base leading-tight tracking-tight">
          TheOnlineProtractor<span class="text-blue-600">.com</span>
        </span>
        <span class="text-[10px] text-neutral-500 font-medium leading-none tracking-wide">
          Free Online Protractor Tool
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Main Navigation">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'home'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        Standard (180°)
      </a>
      <a
        href="/image-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'image'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        🖼️ Image & Worksheet
      </a>
      <a
        href="/360-degree-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === '360'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        ⭕ 360° Digital Dial
      </a>
      <a
        href="/printable-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'printable'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        🖨️ Protractor Printable
      </a>
    </nav>

    <!-- Right Action Button -->
    <div class="flex items-center gap-2">
      <a
        href="/printable-protractor"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold hover:bg-blue-100 transition-colors border border-blue-200/60 shadow-2xs"
      >
        <span>Print Free PDF</span>
      </a>
    </div>
  </div>
</header>
