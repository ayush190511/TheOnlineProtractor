---
interface Props {
  activePage?: 'home' | 'image' | '360' | 'printable';
}

const { activePage = 'home' } = Astro.props;
---

<header class="w-full border-b border-neutral-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group" title="TheOnlineProtractor.com — Free Online Protractor">
      <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
        📐
      </div>
      <div class="flex flex-col">
        <span class="font-black text-neutral-900 text-base leading-tight tracking-tight">
          TheOnlineProtractor<span class="text-blue-600">.com</span>
        </span>
        <span class="text-[10px] text-neutral-500 font-medium leading-none tracking-wide">
          Free Online Protractor Tool
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Main Navigation">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'home'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        Standard (180°)
      </a>
      <a
        href="/image-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'image'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        🖼️ Image & Worksheet
      </a>
      <a
        href="/360-degree-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === '360'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        ⭕ 360° Digital Dial
      </a>
      <a
        href="/printable-protractor"
        class={`px-3 py-1.5 rounded-lg transition-colors ${
          activePage === 'printable'
            ? 'bg-neutral-100 text-blue-600 font-semibold'
            : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900'
        }`}
      >
        🖨️ Protractor Printable
      </a>
    </nav>

    <!-- Right Action Button -->
    <div class="flex items-center gap-2">
      <a
        href="/printable-protractor"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold hover:bg-blue-100 transition-colors border border-blue-200/60 shadow-2xs"
      >
        <span>Print Free PDF</span>
      </a>
    </div>
  </div>
</header>
