---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: 'home' | 'image' | '360' | 'printable' | 'about' | 'privacy' | 'terms' | 'contact';
}

const {
  title = 'TheOnlineProtractor.com — Free Online Protractor & Angle Finder',
  description = 'TheOnlineProtractor.com is the #1 free online protractor tool. Measure angles online with 180° and 360° digital protractors, upload worksheets or photos, and download printable protractor templates.',
  activePage = 'home',
} = Astro.props;

const siteUrl = 'https://theonlineprotractor.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const jsonLdWebApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TheOnlineProtractor.com',
  url: siteUrl,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires HTML5 Canvas support',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Online 180 and 360 degree protractor dials',
    'Interactive draggable vertices with 2.5x magnifier loupe',
    'Clipboard paste support for measuring angles from worksheets and photos',
    'High-resolution annotated image export',
    '1:1 scale actual size printable protractor PDF templates',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC Theme Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="protractor, how to use a protractor, online protractor, printable protractor, what is a protractor, digital protractor, protractor printable, protractor tool, protractor and compass, measuring angles with a protractor worksheet, online protractor tool, online protractor practice, how to read a protractor" />
    <meta name="author" content="TheOnlineProtractor.com" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/logo.svg`} />
    <meta property="og:site_name" content="TheOnlineProtractor.com" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/logo.svg`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebApp)} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#ffffff] dark:bg-[#121212] text-neutral-900 dark:text-[#f8fafc] antialiased transition-colors duration-200">
    <Header activePage={activePage} />
    
    <main class="flex-1 w-full max-w-6xl mx-auto px-3 sm:px-6 py-4 sm:py-6">
      <slot />
    </main>

    <Footer />
  </body>
</html>
