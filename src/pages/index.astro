---
import Layout from '../layouts/Layout.astro';
import { ProtractorApp } from '../components/ProtractorApp';
import { AdContainer } from '../components/AdContainer';
import EducationalGuide from '../components/EducationalGuide.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<Layout
  title="TheOnlineProtractor.com — Free Online Protractor & Digital Angle Finder"
  description="TheOnlineProtractor.com is the #1 free online protractor tool. Measure angles online with 180° and 360° digital protractors, upload worksheets or photos, and download printable protractors."
  activePage="home"
>
  <!-- Hero Section -->
  <section class="text-center pt-2 pb-6 max-w-3xl mx-auto px-2">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200/60 dark:border-blue-800 text-blue-700 dark:text-sky-300 text-xs font-bold mb-3 shadow-2xs">
      <span>📐 TheOnlineProtractor.com</span>
      <span class="w-1.5 h-1.5 rounded-full bg-blue-600 dark:bg-sky-400"></span>
      <span class="text-neutral-500 dark:text-neutral-400 font-normal">0.1° High-Precision Digital Tool</span>
    </div>
    
    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-neutral-900 dark:text-white tracking-tight mb-3">
      Free Online Protractor & Angle Finder
    </h1>
    <p class="text-xs sm:text-base text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto leading-relaxed">
      Welcome to <strong>TheOnlineProtractor.com</strong> — the fast, kid-friendly <strong>online protractor tool</strong> designed for students, math teachers, and engineers. Measure any angle on your screen, upload math homework worksheets, paste screenshot photos with <kbd class="px-1.5 py-0.5 bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 rounded text-xs font-mono font-bold text-neutral-800 dark:text-neutral-200">Ctrl+V</kbd>, or use your live webcam with 0.1° accuracy.
    </p>
  </section>

  <!-- Zero-CLS Top Leaderboard Ad -->
  <AdContainer slot="top-leaderboard" />

  <!-- Main Interactive Protractor Island -->
  <div class="my-4">
    <ProtractorApp client:load initialToolMode="standard" initialProtractorMode="180" />
  </div>

  <!-- Zero-CLS Bottom Leaderboard Ad -->
  <AdContainer slot="bottom-leaderboard" />

  <!-- Quick Feature Overview Grid for SEO & User Experience -->
  <section class="w-full my-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-neutral-800 dark:text-neutral-200" aria-label="Tool Features">
    <div class="bg-[#faf9f8] dark:bg-[#181818] border border-neutral-200/80 dark:border-neutral-800 rounded-xl p-4.5">
      <div class="text-2xl mb-2">🎯</div>
      <h3 class="font-bold text-sm text-neutral-900 dark:text-white mb-1">2.5x Magnifier Loupe</h3>
      <p class="text-xs text-neutral-600 dark:text-neutral-400">Crosshair zoom automatically activates while dragging pins for sub-pixel accuracy on tiny geometry diagrams.</p>
    </div>

    <div class="bg-[#faf9f8] dark:bg-[#181818] border border-neutral-200/80 dark:border-neutral-800 rounded-xl p-4.5">
      <div class="text-2xl mb-2">📋</div>
      <h3 class="font-bold text-sm text-neutral-900 dark:text-white mb-1">Instant Clipboard Paste</h3>
      <p class="text-xs text-neutral-600 dark:text-neutral-400">Press <kbd class="px-1 bg-neutral-200 dark:bg-neutral-700 rounded font-mono">Ctrl+V</kbd> anywhere on this page to immediately load homework worksheets and screenshots.</p>
    </div>

    <div class="bg-[#faf9f8] dark:bg-[#181818] border border-neutral-200/80 dark:border-neutral-800 rounded-xl p-4.5">
      <div class="text-2xl mb-2">⚡</div>
      <h3 class="font-bold text-sm text-neutral-900 dark:text-white mb-1">Angle Snapping & Nudge</h3>
      <p class="text-xs text-neutral-600 dark:text-neutral-400">Smart magnetic snapping to 30°, 45°, 60°, 90°, and 180°, with ±0.1° and ±1.0° fine-tuning buttons.</p>
    </div>

    <div class="bg-[#faf9f8] dark:bg-[#181818] border border-neutral-200/80 dark:border-neutral-800 rounded-xl p-4.5">
      <div class="text-2xl mb-2">🖨️</div>
      <h3 class="font-bold text-sm text-neutral-900 dark:text-white mb-1">Printable Protractor (1:1)</h3>
      <p class="text-xs text-neutral-600 dark:text-neutral-400">One-click actual-size printable protractor templates calibrated with 50mm scale test bars for A4 and US Letter paper.</p>
    </div>
  </section>

  <!-- Quick Explore Links Section (Visible on Front Page) -->
  <section class="w-full my-8 p-6 bg-white dark:bg-[#1e1e1e] border border-neutral-200/80 dark:border-neutral-800 rounded-2xl shadow-xs">
    <div class="flex items-center justify-between gap-4 mb-4 flex-wrap">
      <div>
        <h2 class="text-lg font-bold text-neutral-900 dark:text-white">Explore More Tools & Resources</h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">Everything you need for geometry, homework, and classroom learning.</p>
      </div>
      <span class="text-xs text-blue-600 dark:text-sky-400 font-semibold">100% Free Forever</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
      <a href="/image-protractor" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">🖼️</span>
        <span class="font-bold text-neutral-900 dark:text-white">Worksheet Mode</span>
      </a>

      <a href="/360-degree-protractor" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">⭕</span>
        <span class="font-bold text-neutral-900 dark:text-white">360° Dial</span>
      </a>

      <a href="/printable-protractor" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">🖨️</span>
        <span class="font-bold text-neutral-900 dark:text-white">Printable 1:1</span>
      </a>

      <a href="/about" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">📖</span>
        <span class="font-bold text-neutral-900 dark:text-white">About Us</span>
      </a>

      <a href="/contact" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">📬</span>
        <span class="font-bold text-neutral-900 dark:text-white">Contact Us</span>
      </a>

      <a href="/privacy-policy" class="p-3 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50/50 dark:bg-neutral-800/50 hover:bg-blue-50 dark:hover:bg-blue-950/40 hover:border-blue-300 dark:hover:border-blue-700 transition-all flex flex-col items-center text-center">
        <span class="text-xl mb-1">🔒</span>
        <span class="font-bold text-neutral-900 dark:text-white">Privacy Policy</span>
      </a>
    </div>
  </section>

  <!-- Comprehensive 800+ Word Educational Guide -->
  <EducationalGuide />

  <!-- 10 Detailed FAQs -->
  <FaqAccordion />
</Layout>
