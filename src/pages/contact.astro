---
import Layout from '../layouts/Layout.astro';
import { AdContainer } from '../components/AdContainer';
---

<Layout
  title="Contact Us — TheOnlineProtractor.com"
  description="Contact the team at TheOnlineProtractor.com. Send feedback, feature requests, classroom inquiries, or bug reports with direct Google Sheets logging."
  activePage="contact"
>
  <div class="max-w-3xl mx-auto py-4">
    <!-- Header -->
    <div class="border-b border-neutral-200/80 dark:border-neutral-800 pb-6 mb-8 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200/60 dark:border-blue-800 text-blue-700 dark:text-sky-300 text-xs font-bold mb-3 shadow-2xs">
        <span>📬 Direct Google Sheets Integration</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-neutral-900 dark:text-white tracking-tight mb-2">
        Contact & Feedback
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base leading-relaxed">
        Have a question, feedback, feature request, or classroom inquiry? Fill out the form below. Messages are saved directly to our contact Google Sheet.
      </p>
    </div>

    <AdContainer slot="top-leaderboard" />

    <!-- Main Contact Form Card -->
    <div class="bg-white dark:bg-[#1e1e1e] border border-neutral-200/80 dark:border-neutral-800 rounded-2xl p-6 sm:p-8 shadow-xs my-8">
      
      <!-- Submission Status Alerts -->
      <div id="status-success" class="hidden mb-6 p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300 text-sm flex items-start gap-3 animate-in fade-in">
        <span class="text-2xl">✅</span>
        <div>
          <h4 class="font-bold">Message Sent Successfully!</h4>
          <p class="text-xs mt-0.5">Your message was recorded into our Google Sheet. Thank you for reaching out!</p>
        </div>
      </div>

      <div id="status-error" class="hidden mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-900 dark:text-red-300 text-sm flex items-start gap-3 animate-in fade-in">
        <span class="text-2xl">⚠️</span>
        <div>
          <h4 class="font-bold">Submission Notice</h4>
          <p class="text-xs mt-0.5" id="error-message">Unable to reach Google Sheets. Please check your connection and try again.</p>
        </div>
      </div>

      <form id="contact-form" class="space-y-4" method="POST">
        <!-- Name & Email Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5">
              Your Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Johnson"
              class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#181818] text-neutral-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-neutral-400"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5">
              Email Address <span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="e.g. alex@example.com"
              class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#181818] text-neutral-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-neutral-400"
            />
          </div>
        </div>

        <!-- Subject & Topic -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="category" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5">
              Inquiry Category
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#181818] text-neutral-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
            >
              <option value="General Feedback">💡 General Feedback / Suggestion</option>
              <option value="Feature Request">✨ Feature Request</option>
              <option value="School / Teacher">🏫 School & Classroom Inquiry</option>
              <option value="Bug Report">🐛 Bug / Math Issue Report</option>
              <option value="Other">💬 Other</option>
            </select>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Brief summary..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#181818] text-neutral-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-neutral-400"
            />
          </div>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-xs font-bold text-neutral-700 dark:text-neutral-300 uppercase tracking-wider mb-1.5">
            Your Message <span class="text-red-500">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Tell us what's on your mind..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-[#181818] text-neutral-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder:text-neutral-400 resize-y"
          ></textarea>
        </div>

        <!-- Submit Button & Controls -->
        <div class="pt-2 flex items-center justify-between gap-4 flex-wrap">
          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btn-text">Submit Message</span>
            <span id="btn-spinner" class="hidden animate-spin">⏳</span>
          </button>
          
          <span class="text-[11px] text-neutral-500 dark:text-neutral-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Instant Google Sheets Sync</span>
          </span>
        </div>
      </form>
    </div>

    <!-- Google Sheet Configuration & Setup Instructions -->
    <div class="bg-neutral-50 dark:bg-[#181818] border border-neutral-200/80 dark:border-neutral-800 rounded-xl p-5 text-xs text-neutral-700 dark:text-neutral-300 space-y-3">
      <div class="flex items-center justify-between gap-2 border-b border-neutral-200 dark:border-neutral-700 pb-2">
        <span class="font-bold text-sm text-neutral-900 dark:text-white flex items-center gap-2">
          <span>📊</span>
          <span>Google Apps Script Setup Checklist</span>
        </span>
        <span class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-950 text-blue-800 dark:text-sky-300 font-mono text-[10px] font-bold">Important</span>
      </div>

      <p class="leading-relaxed">
        Ensure your Google Apps Script has these settings configured:
      </p>

      <ol class="list-decimal list-inside space-y-1.5 text-neutral-600 dark:text-neutral-400">
        <li><strong>Access Permission:</strong> In Apps Script, click <strong>Deploy &gt; Manage deployments &gt; Edit (pencil icon)</strong>, and ensure <strong>"Who has access"</strong> is set to <strong class="text-neutral-900 dark:text-white font-semibold">"Anyone"</strong>.</li>
        <li><strong>Code in Code.gs:</strong> Paste this exact code in your Google Sheet's <em>Extensions &gt; Apps Script</em>:</li>
      </ol>

      <pre class="p-3 bg-neutral-900 text-emerald-400 rounded-lg font-mono text-[11px] overflow-x-auto select-all leading-relaxed">
function doPost(e) &#123;
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var p = e.parameter;
  sheet.appendRow([
    new Date(),
    p.name || '',
    p.email || '',
    p.category || '',
    p.subject || '',
    p.message || ''
  ]);
  return ContentService.createTextOutput(JSON.stringify(&#123; result: "success" &#125;))
    .setMimeType(ContentService.MimeType.JSON);
&#125;

function doGet(e) &#123;
  return doPost(e);
&#125;</pre>
    </div>

    <AdContainer slot="bottom-leaderboard" />
  </div>
</Layout>

<script is:inline>
  const GOOGLE_SHEET_URL = 'https://script.google.com/macros/s/AKfycbzhqJOGOO71QBS_-5FjbmOFS9TsLo6qKJw2WVGqrp-dU5NEyDxj5LYBbXQ3cfTZZohU/exec';

  function initContactForm() {
    const form = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');
    const successAlert = document.getElementById('status-success');
    const errorAlert = document.getElementById('status-error');

    if (form) {
      form.onsubmit = function(e) {
        e.preventDefault();
        
        // Extract values
        const nameVal = form.elements['name'].value;
        const emailVal = form.elements['email'].value;
        const categoryVal = form.elements['category'].value;
        const subjectVal = form.elements['subject'].value;
        const messageVal = form.elements['message'].value;
        const timestampVal = new Date().toISOString();

        // Encode as URLSearchParams
        const params = new URLSearchParams();
        params.append('timestamp', timestampVal);
        params.append('name', nameVal);
        params.append('email', emailVal);
        params.append('category', categoryVal);
        params.append('subject', subjectVal);
        params.append('message', messageVal);

        // Instant Optimistic UI: Show success feedback immediately (zero waiting time!)
        if (submitBtn) submitBtn.disabled = true;
        if (btnText) btnText.textContent = 'Sent!';
        if (successAlert) successAlert.classList.remove('hidden');
        if (errorAlert) errorAlert.classList.add('hidden');
        
        // Reset inputs
        form.reset();

        // Re-enable button after 1.5s
        setTimeout(() => {
          if (submitBtn) submitBtn.disabled = false;
          if (btnText) btnText.textContent = 'Submit Message';
        }, 1500);

        // Send payload in background via Beacon or Fetch
        try {
          if (navigator.sendBeacon) {
            navigator.sendBeacon(GOOGLE_SHEET_URL, params);
          } else {
            fetch(GOOGLE_SHEET_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: params.toString(),
            });
          }
        } catch (err) {
          // Non-blocking fallback
          fetch(`${GOOGLE_SHEET_URL}?${params.toString()}`, { method: 'GET', mode: 'no-cors' }).catch(() => {});
        }
      };
    }
  }

  initContactForm();
  document.addEventListener('DOMContentLoaded', initContactForm);
</script>
